# Токен бота от @BotFather. Храни только в переменных хостинга, не в репозитории.
BOT_TOKEN=
# Публичный HTTPS-адрес приложения, например https://semeinoe-delo.up.railway.app
WEBAPP_URL=
# Postgres. На Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# DATABASE_SSL=true    # включи, если хостинг базы требует SSL
# Ключ Claude API: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Кому можно пользоваться ботом: твой Telegram id (узнать у @userinfobot). Через запятую, если несколько.
ALLOWED_USER_IDS=
# Необязательно: бесплатный ключ https://www.pexels.com/api/ для поиска фото и видео
PEXELS_API_KEY=
# Необязательно: секрет для вебхука. Без него бот работает через long polling.
WEBHOOK_SECRET=
# Только для локальной разработки без Telegram
# DEV_USER_ID=123
